<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:Nacionalidad.App.Views"
       xmlns:loc="clr-namespace:Nacionalidad.App.Localization"
       x:Class="Nacionalidad.App.AppShell"
       Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent Title="{loc:Tr Tab_Home}"
                      Icon="tab_home.png"
                      ContentTemplate="{DataTemplate views:HomePage}"
                      Route="home" />
        <ShellContent Title="{loc:Tr Tab_Stats}"
                      Icon="tab_stats.png"
                      ContentTemplate="{DataTemplate views:StatsPage}"
                      Route="stats" />
        <ShellContent Title="{loc:Tr Tab_Settings}"
                      Icon="tab_settings.png"
                      ContentTemplate="{DataTemplate views:SettingsPage}"
                      Route="settings" />
    </TabBar>
</Shell>
