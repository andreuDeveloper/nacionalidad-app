<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:Nacionalidad.App.Converters"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Nacionalidad.App.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:OptionStateToColorConverter x:Key="OptionBackground" Part="Background" />
            <conv:OptionStateToColorConverter x:Key="OptionStroke" Part="Stroke" />
            <conv:OptionStateToColorConverter x:Key="OptionBadge" Part="Badge" />
            <conv:BoolToResultColorConverter x:Key="ResultColor" />
            <conv:BoolToResultBackgroundConverter x:Key="ResultBackground" />
            <toolkit:InvertedBoolConverter x:Key="Not" />
            <toolkit:IsStringNotNullOrEmptyConverter x:Key="HasText" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
