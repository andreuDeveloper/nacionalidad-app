<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Solo Android por ahora. Para iOS en el futuro: añadir net10.0-ios aquí y una carpeta Platforms/iOS. -->
    <TargetFrameworks>net10.0-android</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>Nacionalidad.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Compilación de XAML con source generator y bindings compilados -->
    <MauiXamlInflator>SourceGen</MauiXamlInflator>
    <MauiStrictXamlCompilation>true</MauiStrictXamlCompilation>

    <ApplicationTitle>Nacionalidad España</ApplicationTitle>
    <ApplicationId>com.andreudeveloper.nacionalidad</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>

    <!-- Idiomas de la interfaz: español (neutral), árabe, inglés, francés y urdu -->
    <NeutralLanguage>es</NeutralLanguage>
    <SatelliteResourceLanguages>es;ar;en;fr;ur</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AndroidPackageFormat>aab</AndroidPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#C60B1E" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#C60B1E" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Bancos de preguntas y contenidos: se empaquetan como assets y se leen con FileSystem.OpenAppPackageFileAsync -->
    <MauiAsset Include="Content\**\*.json" LogicalName="Content/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="CommunityToolkit.Maui" Version="16.0.0" />
    <!-- 1.11 usa SQLitePCLRaw 3 + SourceGear.sqlite3 (SQLite actualizado, compatible con páginas de 16 KB) -->
    <PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
    <PackageReference Include="Plugin.InAppBilling" Version="11.0.1" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <!-- Google Play Billing 9 necesita AndroidX Lifecycle más reciente que el que trae MAUI 10: se fuerza aquí. -->
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Collection.Ktx" Version="1.6.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExamEngine.Core\ExamEngine.Core.csproj" />
  </ItemGroup>

</Project>
